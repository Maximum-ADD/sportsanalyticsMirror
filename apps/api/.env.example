DATABASE_URL="postgresql://postgres:postgres@localhost:55432/nba_analytics?schema=public"
# Only needed against Supabase: the pooler (port 6543, pgbouncer=true) is used
# for DATABASE_URL above, but `prisma migrate deploy` needs a direct, non-pooled
# connection (port 5432 on db.<project-ref>.supabase.co) for its advisory locks.
# DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
PORT=4000
# Optional diagnostics/tuning — both default to off:
#   PRISMA_LOG_QUERIES=true  prints every SQL statement (count round trips per page load)
#   API_CACHE_DISABLED=true  turns off the in-memory response cache (see src/cache/)
# PRISMA_LOG_QUERIES=true
# API_CACHE_DISABLED=true
WEB_ORIGIN="http://localhost:5173"  # comma-separated for multiple origins, e.g. "https://app.pages.dev,http://localhost:5173"

# BetterAuth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:4000"

# Google OAuth client — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase Storage — used server-side only for avatar uploads (Project Settings → API Keys for the secret key).
# SUPABASE_SECRET_KEY bypasses Row Level Security; never expose it to the frontend.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_AVATARS_BUCKET="profile pictures"

# Optional. How the admin "Pull Data" button runs a pull. Left unset, the API
# runs ingest.py itself when apps/ingestion and its .venv exist next to it
# (local dev), and otherwise queues the pull for a pull worker
# (apps/ingestion/pull_worker.py) — which is what the deployed API does,
# since stats.nba.com blocks cloud IPs. Set to "queue" to force queueing
# locally, e.g. to try the queue-and-worker flow end to end.
# INGESTION_MODE="queue"
