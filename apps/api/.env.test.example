DATABASE_URL="postgresql://postgres:postgres@localhost:55433/nba_analytics_test?schema=public"
# Same database — schema.prisma declares directUrl for migration deploys, and
# the local test Postgres has no pooler, so the direct connection is the
# connection. CI writes the same line into its generated .env.test.
DIRECT_URL="postgresql://postgres:postgres@localhost:55433/nba_analytics_test?schema=public"
PORT=4000
WEB_ORIGIN="http://localhost:5173"

# Not real secrets — this database is thrown away between CI runs and never
# holds real user data. Copy this file to .env.test to run tests locally.
BETTER_AUTH_SECRET="test-secret-do-not-use-in-production"
BETTER_AUTH_URL="http://localhost:4000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Not real — AvatarStorageService's Supabase client only needs a
# well-formed URL to construct successfully; no test exercises a real
# Storage call (unit specs mock the client, see me/avatar-storage.service.ts's
# callers), so a live project ref isn't needed here.
SUPABASE_URL="https://test-project.supabase.co"
SUPABASE_SECRET_KEY="test-secret-key"
SUPABASE_AVATARS_BUCKET="profile pictures"
