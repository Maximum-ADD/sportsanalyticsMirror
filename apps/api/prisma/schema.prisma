// Prisma schema for the NBA Analytics Platform.
// Postgres is used purely as managed storage — all reads/writes go through
// this NestJS API, nothing is exposed directly to clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLIC
  USER
  ANALYST
  ADMIN
}

// User/Session/Account/Verification below follow BetterAuth's required core
// schema (https://better-auth.com/docs/concepts/database) — field names and
// types must match what its Prisma adapter expects. `role` is a
// project-specific addition layered on top for RBAC (see RolesGuard),
// defaulted here and marked non-writable in the BetterAuth config so a
// Google profile can never grant itself elevated access.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per linked sign-in method (e.g. Google) for a user.
model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Short-lived tokens for flows like email verification (unused while the
// only sign-in method is Google OAuth, but part of BetterAuth's core schema).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Team {
  id           String   @id @default(uuid())
  nbaTeamId    Int      @unique
  name         String
  abbreviation String
  city         String
  conference   String
  division     String
  logoUrl      String?

  players Player[]
  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")
}

model Player {
  id           String   @id @default(uuid())
  nbaPlayerId  Int      @unique
  firstName    String
  lastName     String
  position     String
  heightInches Int?
  weightLbs    Int?
  jerseyNumber String?
  headshotUrl  String?
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])

  // Bio fields from CommonPlayerInfo, layered onto the roster-sourced
  // fields above. Deliberately excludes that endpoint's TEAM_ID/TEAM_NAME/
  // etc — those only ever reflect the player's *current* team at request
  // time (e.g. post-trade), which would silently overwrite the correct,
  // season-scoped team CommonTeamRoster already gave us in rosters.py.
  // Team assignment stays sourced from the roster ingestion only.
  birthDate       DateTime?
  school          String?
  country         String?
  lastAffiliation String?
  seasonExp       Int?
  rosterStatus    String?
  draftYear       Int?
  draftRound      Int?
  draftNumber     Int?

  gameStats   PlayerGameStat[]
  predictions PlayerPrediction[]
  lineupSlots LineupSlot[]
}

model Game {
  id           String   @id @default(uuid())
  nbaGameId    String   @unique
  gameDate     DateTime
  season       String
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?

  playerStats  PlayerGameStat[]
  events       GameEvent[]
  prediction   GamePrediction?
}

// Raw play-by-play events — the source of truth every derived stat traces back to.
model GameEvent {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  sequence    Int
  period      Int
  clock       String
  eventType   String
  playerId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([gameId, sequence])
}

// Per-game boxscore figures — derived from GameEvent rows, never entered by hand.
model PlayerGameStat {
  id        String  @id @default(uuid())
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id])
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id])

  minutes      Int
  points       Int
  rebounds     Int
  assists      Int
  steals       Int
  blocks       Int
  turnovers    Int
  fieldGoalsMade Int
  fieldGoalsAttempted Int
  threesMade   Int
  threesAttempted Int
  freeThrowsMade Int
  freeThrowsAttempted Int

  @@unique([playerId, gameId])
}

// Below models support the fantasy-lineup optimizer: a small Python service
// (apps/optimizer) predicts each player's next-game fantasy points and
// picks an optimal lineup under a salary cap, writing its output here.
// NestJS only ever reads these tables — nothing under /v1 writes to them.

// One row per player per optimizer run. `salary` is a synthetic DFS-style
// cost derived from the same prediction (there's no public API for real
// DraftKings/FanDuel pricing), not a real market price — see
// apps/optimizer/predict.py.
model PlayerPrediction {
  id                     String   @id @default(uuid())
  playerId               String
  player                 Player   @relation(fields: [playerId], references: [id])
  predictedFantasyPoints Float
  salary                 Int
  asOf                   DateTime @default(now())

  @@index([playerId, asOf])
}

// A single optimizer run's chosen lineup (MILP solve over the latest
// PlayerPrediction rows) — see apps/optimizer/optimize.py.
model Lineup {
  id                   String   @id @default(uuid())
  totalPredictedPoints Float
  totalSalary          Int
  budget               Int
  createdAt            DateTime @default(now())

  slots LineupSlot[]
}

model LineupSlot {
  id       String @id @default(uuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

// Below model supports game-outcome prediction: a small Python service
// (apps/predictor) computes an Elo-based home win probability and a Four
// Factors-based predicted score margin for each game, writing its output
// here. NestJS only ever reads this table — nothing under /v1 writes to it.
//
// One row per Game (@@unique([gameId]), upserted on rerun) rather than
// PlayerPrediction's append-and-take-latest-by-asOf shape: nothing here
// wants "what did we predict for this game last Tuesday vs today" the way
// fantasy-point predictions do, so a single row keeps reads a direct
// `game.prediction` relation instead of a DISTINCT ON query.
model GamePrediction {
  id String @id @default(uuid())

  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id])

  // Elo-based win probability for the home team, in [0, 1]. See
  // apps/predictor/elo.py.
  homeWinProbability Float

  // Elo ratings each team carried into this game, before it was played —
  // kept alongside the derived probability so a caller can see why it came
  // out the way it did, not just the number itself.
  homeTeamEloPre Float
  awayTeamEloPre Float

  // Four Factors-based predicted margin, home minus away, in points. See
  // apps/predictor/four_factors.py. Null when either team has no completed
  // games yet to average Four Factors from.
  predictedMarginHome Float?

  // Which method produced predictedMarginHome: "regression" (fitted OLS)
  // or "heuristic" (fixed literature-informed weights, used when there
  // isn't enough game history to fit a regression reliably — see
  // four_factors.py's MINIMUM_GAMES_FOR_REGRESSION). Null alongside a null
  // predictedMarginHome.
  marginMethod String?

  createdAt DateTime @default(now())

  @@index([gameId])
}
