// Prisma schema for the NBA Analytics Platform.
// Postgres is used purely as managed storage — all reads/writes go through
// this NestJS API, nothing is exposed directly to clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLIC
  USER
  ANALYST
  ADMIN
}

// User/Session/Account/Verification below follow BetterAuth's required core
// schema (https://better-auth.com/docs/concepts/database) — field names and
// types must match what its Prisma adapter expects. `role` is a
// project-specific addition layered on top for RBAC (see RolesGuard),
// defaulted here and marked non-writable in the BetterAuth config so a
// Google profile can never grant itself elevated access.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  // Personalization — the user's own rows (see the models at the foot of
  // this file). Cascade on delete: deleting an account takes its choices
  // with it, leaving no orphaned personalization behind.
  followedPlayers  FollowedPlayer[]
  followedTeams    FollowedTeam[]
  gamePicks        GamePick[]
  savedComparisons SavedComparison[]
  savedLineups     SavedLineup[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per linked sign-in method (e.g. Google) for a user.
model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Short-lived tokens for flows like email verification (unused while the
// only sign-in method is Google OAuth, but part of BetterAuth's core schema).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Team {
  id           String  @id @default(uuid())
  nbaTeamId    Int     @unique
  name         String
  abbreviation String
  city         String
  conference   String
  division     String
  logoUrl      String?

  players   Player[]
  homeGames Game[]   @relation("HomeTeam")
  awayGames Game[]   @relation("AwayTeam")

  followedBy FollowedTeam[]
}

model Player {
  id           String  @id @default(uuid())
  nbaPlayerId  Int     @unique
  firstName    String
  lastName     String
  position     String
  heightInches Int?
  weightLbs    Int?
  jerseyNumber String?
  headshotUrl  String?
  teamId       String?
  team         Team?   @relation(fields: [teamId], references: [id])

  // Bio fields from CommonPlayerInfo, layered onto the roster-sourced
  // fields above. Deliberately excludes that endpoint's TEAM_ID/TEAM_NAME/
  // etc — those only ever reflect the player's *current* team at request
  // time (e.g. post-trade), which would silently overwrite the correct,
  // season-scoped team CommonTeamRoster already gave us in rosters.py.
  // Team assignment stays sourced from the roster ingestion only.
  birthDate       DateTime?
  school          String?
  country         String?
  lastAffiliation String?
  seasonExp       Int?
  rosterStatus    String?
  draftYear       Int?
  draftRound      Int?
  draftNumber     Int?

  gameStats   PlayerGameStat[]
  predictions PlayerPrediction[]
  lineupSlots LineupSlot[]

  followedBy           FollowedPlayer[]
  savedComparisonSlots SavedComparisonPlayer[]
  savedLineupSlots     SavedLineupSlot[]
}

model Game {
  id         String   @id @default(uuid())
  nbaGameId  String   @unique
  gameDate   DateTime
  season     String
  homeTeamId String
  awayTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int?
  awayScore  Int?

  playerStats PlayerGameStat[]
  events      GameEvent[]
  prediction  GamePrediction?

  picks GamePick[]
}

// Raw play-by-play events — the source of truth every derived stat traces back to.
model GameEvent {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  sequence    Int
  period      Int
  clock       String
  eventType   String
  playerId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([gameId, sequence])
}

// Per-game boxscore figures — derived from GameEvent rows, never entered by hand.
model PlayerGameStat {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id])

  minutes             Int
  points              Int
  rebounds            Int
  assists             Int
  steals              Int
  blocks              Int
  turnovers           Int
  fieldGoalsMade      Int
  fieldGoalsAttempted Int
  threesMade          Int
  threesAttempted     Int
  freeThrowsMade      Int
  freeThrowsAttempted Int

  @@unique([playerId, gameId])
}

// Below models support the fantasy-lineup optimizer: a small Python service
// (apps/optimizer) predicts each player's next-game fantasy points and
// picks an optimal lineup under a salary cap, writing its output here.
// NestJS only ever reads these tables — nothing under /v1 writes to them.

// One row per player per optimizer run. `salary` is a synthetic DFS-style
// cost derived from the same prediction (there's no public API for real
// DraftKings/FanDuel pricing), not a real market price — see
// apps/optimizer/predict.py.
model PlayerPrediction {
  id                     String   @id @default(uuid())
  playerId               String
  player                 Player   @relation(fields: [playerId], references: [id])
  predictedFantasyPoints Float
  salary                 Int
  asOf                   DateTime @default(now())

  @@index([playerId, asOf])
}

// A single optimizer run's chosen lineup (MILP solve over the latest
// PlayerPrediction rows) — see apps/optimizer/optimize.py.
model Lineup {
  id                   String   @id @default(uuid())
  totalPredictedPoints Float
  totalSalary          Int
  budget               Int
  createdAt            DateTime @default(now())

  slots LineupSlot[]
}

model LineupSlot {
  id       String @id @default(uuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

// Below model supports game-outcome prediction: a small Python service
// (apps/predictor) computes an Elo-based home win probability and a Four
// Factors-based predicted score margin for each game, writing its output
// here. NestJS only ever reads this table — nothing under /v1 writes to it.
//
// One row per Game (@@unique([gameId]), upserted on rerun) rather than
// PlayerPrediction's append-and-take-latest-by-asOf shape: nothing here
// wants "what did we predict for this game last Tuesday vs today" the way
// fantasy-point predictions do, so a single row keeps reads a direct
// `game.prediction` relation instead of a DISTINCT ON query.
model GamePrediction {
  id String @id @default(uuid())

  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id])

  // Elo-based win probability for the home team, in [0, 1]. See
  // apps/predictor/elo.py.
  homeWinProbability Float

  // Elo ratings each team carried into this game, before it was played —
  // kept alongside the derived probability so a caller can see why it came
  // out the way it did, not just the number itself.
  homeTeamEloPre Float
  awayTeamEloPre Float

  // Four Factors-based predicted margin, home minus away, in points. See
  // apps/predictor/four_factors.py. Null when either team has no completed
  // games yet to average Four Factors from.
  predictedMarginHome Float?

  // Which method produced predictedMarginHome: "regression" (fitted OLS)
  // or "heuristic" (fixed literature-informed weights, used when there
  // isn't enough game history to fit a regression reliably — see
  // four_factors.py's MINIMUM_GAMES_FOR_REGRESSION). Null alongside a null
  // predictedMarginHome.
  marginMethod String?

  createdAt DateTime @default(now())

  @@index([gameId])
}

// ─────────────────────────────────────────────────────────────────────────
// Personalization models. Everything below records a CHOICE THE USER MADE —
// which players they follow, which games they called, which comparisons and
// lineups they saved. No NBA data is ingested, derived or duplicated here
// beyond the deliberate at-the-time snapshots documented on GamePick and
// SavedLineup; the pipeline's own tables (Team/Player/Game/PlayerGameStat/
// GamePrediction/PlayerPrediction/Lineup) stay read-only exactly as before.
//
// Every relation uses onDelete: Cascade, toward Player/Team/Game as well as
// User. Prisma's default (Restrict) would mean a single followed player is
// enough to make a re-ingestion that deletes and rewrites roster rows fail
// outright — a user's bookmark must never be able to block the data pipeline.
// ─────────────────────────────────────────────────────────────────────────

// A player the user has chosen to keep an eye on, with an optional personal
// note ("watch his 3PT% after the trade").
model FollowedPlayer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
  @@index([userId, createdAt])
}

// A team the user follows. `isPrimary` marks the one team the home page
// leads with; enforcing "at most one primary" is the service layer's job,
// not the schema's (Postgres partial unique indexes aren't expressible in
// Prisma schema, and the invariant is cheap to keep in a transaction).
model FollowedTeam {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([userId, createdAt])
}

// Whether the user's call turned out right, once the game has a final score.
enum PickOutcome {
  CORRECT
  MISSED
}

// The user calling a COMPLETED game whose score they have not been shown:
// "I think this team won". Only a game that already has a final score and a
// stored prediction can be called, and it is graded immediately — see
// PicksService.createPick and ChallengeService.findNextUncalledGame.
//
// This scores recall and judgement against past games, not forecasts of
// future ones. The same table becomes forward picks unchanged the day
// ingestion starts writing unplayed Game rows.
model GamePick {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Which side the user took. A plain String rather than a relation to Team:
  // it is always one of the game's own homeTeamId/awayTeamId, validated at
  // write time, and a second Team relation here would add a foreign key that
  // buys nothing the game's own two team relations don't already give.
  pickedTeamId String

  // Right or wrong, filled in from the game's final score.
  outcome PickOutcome

  // ── Model snapshot, taken at the moment the pick was made ──
  // These duplicate GamePrediction's columns on purpose. GamePrediction is
  // `gameId @unique` and is UPSERTED by apps/predictor/predict_games.py, so
  // the row is overwritten in place on every run: the numbers the model was
  // showing when the user made this call are destroyed the next time the
  // predictor runs. Copying them here is the only way the question "what did
  // the model say when I called it, and did I disagree?" stays answerable —
  // reading GamePrediction later answers a different question (what the model
  // says NOW), silently and with no way to tell the difference.
  modelHomeWinProbabilityAtPick Float
  modelPredictedMarginAtPick    Float?
  homeTeamEloAtPick             Float
  awayTeamEloAtPick             Float

  createdAt DateTime @default(now())

  // One call per game per person — a pick is a commitment, not a running
  // opinion, so a second call on the same game is REJECTED with a 409 rather
  // than replacing the first. There is no update path; see
  // translatePickWriteError in picks.service.ts, which turns the P2002 this
  // constraint raises into that 409.
  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

// A named set of players the user lined up side by side, so the same
// comparison can be reopened later without rebuilding it.
model SavedComparison {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  players SavedComparisonPlayer[]

  @@index([userId, createdAt])
}

// One player within a saved comparison. `position` is the left-to-right
// ordering the user arranged them in, not a basketball position — the
// player's basketball position lives on Player.position.
model SavedComparisonPlayer {
  id                String          @id @default(uuid())
  savedComparisonId String
  savedComparison   SavedComparison @relation(fields: [savedComparisonId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position          Int

  @@unique([savedComparisonId, playerId])
}

// A lineup the user chose to keep. `sourceLineupId` records which optimizer
// run it came from (a plain String, not a relation: Lineup rows are the
// optimizer's own churn and may be pruned, and the saved copy must outlive
// them).
model SavedLineup {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  sourceLineupId String?

  // ── Totals snapshot, taken at the moment the lineup was saved ──
  // PlayerPrediction is append-and-take-latest-by-asOf: the optimizer writes
  // a fresh row per player per run and readers take the newest. Re-deriving
  // these totals on read would therefore quietly return different numbers
  // than the ones the user was looking at when they hit save — the lineup
  // would appear to change on its own. Storing them makes the saved lineup a
  // record of a decision rather than a live recomputation.
  totalPredictedPointsAtSave Float
  totalSalaryAtSave          Int
  budgetAtSave               Int

  createdAt DateTime @default(now())

  slots SavedLineupSlot[]

  @@index([userId, createdAt])
}

// One player within a saved lineup, with that player's predicted points and
// salary as they stood at save time — same reason as SavedLineup's totals.
model SavedLineupSlot {
  id            String      @id @default(uuid())
  savedLineupId String
  savedLineup   SavedLineup @relation(fields: [savedLineupId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  predictedPointsAtSave Float
  salaryAtSave          Int

  @@unique([savedLineupId, playerId])
}
