// Prisma schema for the NBA Analytics Platform.
// Postgres is used purely as managed storage — all reads/writes go through
// this NestJS API, nothing is exposed directly to clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PUBLIC
  USER
  ANALYST
  ADMIN
}

// User/Session/Account/Verification below follow BetterAuth's required core
// schema (https://better-auth.com/docs/concepts/database) — field names and
// types must match what its Prisma adapter expects. `role` is a
// project-specific addition layered on top for RBAC (see RolesGuard),
// defaulted here and marked non-writable in the BetterAuth config so a
// Google profile can never grant itself elevated access.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per linked sign-in method (e.g. Google) for a user.
model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Short-lived tokens for flows like email verification (unused while the
// only sign-in method is Google OAuth, but part of BetterAuth's core schema).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Team {
  id           String   @id @default(uuid())
  nbaTeamId    Int      @unique
  name         String
  abbreviation String
  city         String
  conference   String
  division     String
  logoUrl      String?

  players Player[]
  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")
}

model Player {
  id           String   @id @default(uuid())
  nbaPlayerId  Int      @unique
  firstName    String
  lastName     String
  position     String
  heightInches Int?
  weightLbs    Int?
  jerseyNumber String?
  headshotUrl  String?
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])

  gameStats PlayerGameStat[]
}

model Game {
  id           String   @id @default(uuid())
  nbaGameId    String   @unique
  gameDate     DateTime
  season       String
  homeTeamId   String
  awayTeamId   String
  homeTeam     Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam     Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore    Int?
  awayScore    Int?

  playerStats  PlayerGameStat[]
  events       GameEvent[]
}

// Raw play-by-play events — the source of truth every derived stat traces back to.
model GameEvent {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])
  sequence    Int
  period      Int
  clock       String
  eventType   String
  playerId    String?
  description String
  createdAt   DateTime @default(now())

  @@index([gameId, sequence])
}

// Per-game boxscore figures — derived from GameEvent rows, never entered by hand.
model PlayerGameStat {
  id        String  @id @default(uuid())
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id])
  gameId    String
  game      Game    @relation(fields: [gameId], references: [id])

  minutes      Int
  points       Int
  rebounds     Int
  assists      Int
  steals       Int
  blocks       Int
  turnovers    Int
  fieldGoalsMade Int
  fieldGoalsAttempted Int
  threesMade   Int
  threesAttempted Int
  freeThrowsMade Int
  freeThrowsAttempted Int

  @@unique([playerId, gameId])
}
