// Prisma schema for the NBA Analytics Platform.
// Postgres is used purely as managed storage — all reads/writes go through
// this NestJS API, nothing is exposed directly to clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PUBLIC
  USER
  ANALYST
  ADMIN
}

// Which segment of a season a Game belongs to. Every derived statistic in
// this project is computed at request time from PlayerGameStat rows joined
// to Game, so this single discriminator is what keeps a postseason view
// from ever showing regular-season figures (and vice versa) — the
// isolation is enforced by the query, not by careful UI code.
//
// FINALS is its own value rather than PLAYOFFS + playoffRound = 4 because
// "this player's Finals games" is the common query and deserves a plain
// equality filter, the same way GamePrediction.marginMethod models a small
// closed set of variants. playoffRound is kept alongside for round-by-round
// drill-down later.
enum SeasonType {
  REGULAR
  PLAY_IN
  PLAYOFFS
  FINALS
}

// User/Session/Account/Verification below follow BetterAuth's required core
// schema (https://better-auth.com/docs/concepts/database) — field names and
// types must match what its Prisma adapter expects. `role` is a
// project-specific addition layered on top for RBAC (see RolesGuard),
// defaulted here and marked non-writable in the BetterAuth config so a
// Google profile can never grant itself elevated access.
model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Below fields are this project's own additions on top of BetterAuth's
  // core schema (see the module doc comment above) — the personalization
  // step every user completes once, right after their first Google
  // sign-in.
  //
  // Nullable because every account that existed before this feature
  // predates onboarding and has never set one: null/missing username is
  // exactly the signal the frontend gates the /onboarding redirect on
  // (see ProfileGate), not a separate "onboarded" boolean that could drift
  // out of sync with it.
  username String? @unique

  // The Supabase Storage OBJECT PATH ("{userId}/{uuid}.{ext}"), not a full
  // URL — the "profile pictures" bucket is private, so a real, renderable
  // URL only exists for as long as a signed URL is valid. The API
  // constructs that signed URL at request time from this path (see
  // AvatarStorageService); never persisted here since it would go stale.
  avatarUrl String?

  // The one team a user "supports" — onDelete: SetNull so neither side ever
  // blocks the other: deleting a Team (re-ingestion, data fix) shouldn't be
  // able to fail because some user favorited it, and a user is free to have
  // no favorite team at all (not yet onboarded, or the team they favorited
  // was removed).
  favoriteTeamId String?
  favoriteTeam   Team?   @relation(fields: [favoriteTeamId], references: [id], onDelete: SetNull)

  sessions        Session[]
  accounts        Account[]
  followedPlayers UserFollowedPlayer[]

  // The rest of this user's own rows (see the models at the foot of this
  // file). Cascade on delete: deleting an account takes its choices with it,
  // leaving no orphaned personalization behind.
  //
  // Note there is exactly ONE followed-players table — UserFollowedPlayer
  // above. An earlier version of the home page carried a second one
  // (FollowedPlayer, which also held a per-player scouting note); keeping
  // both would have meant a player followed during onboarding never showing
  // up on the watchlist, so the note was dropped and this is now the single
  // source of truth. Same for the favourite team: favoriteTeamId above is
  // it, rather than a separate followed-teams table.
  gamePicks        GamePick[]
  savedComparisons SavedComparison[]
  savedLineups     SavedLineup[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per linked sign-in method (e.g. Google) for a user.
model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Short-lived tokens for flows like email verification (unused while the
// only sign-in method is Google OAuth, but part of BetterAuth's core schema).
model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A user following a player — the app's one "favorite/follow" concept (see
// User.favoriteTeam for the equivalent, singular relationship to a team).
// FKs cascade from the User side only: deleting a user must cleanly drop
// every row here (mirrors Session/Account above, and is what lets
// authClient.deleteUser() hard-delete without a separate cleanup step), but
// deleting a Player is expected to cascade too since a follow of a
// no-longer-existing player is meaningless — there's no SetNull equivalent
// for "who this row is about" the way there is for User.favoriteTeamId.
model UserFollowedPlayer {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, playerId])
}

model Team {
  id           String  @id @default(uuid())
  nbaTeamId    Int     @unique
  name         String
  abbreviation String
  city         String
  conference   String
  division     String
  logoUrl      String?

  players         Player[]
  homeGames       Game[]           @relation("HomeTeam")
  awayGames       Game[]           @relation("AwayTeam")
  playerGameStats PlayerGameStat[]
  events          GameEvent[]
  favoritedBy     User[]
}

model Player {
  id           String  @id @default(uuid())
  nbaPlayerId  Int     @unique
  firstName    String
  lastName     String
  position     String
  heightInches Int?
  weightLbs    Int?
  jerseyNumber String?
  headshotUrl  String?
  teamId       String?
  team         Team?   @relation(fields: [teamId], references: [id])

  // Bio fields from CommonPlayerInfo, layered onto the roster-sourced
  // fields above. Deliberately excludes that endpoint's TEAM_ID/TEAM_NAME/
  // etc — those only ever reflect the player's *current* team at request
  // time (e.g. post-trade), which would silently overwrite the correct,
  // season-scoped team CommonTeamRoster already gave us in rosters.py.
  // Team assignment stays sourced from the roster ingestion only.
  birthDate       DateTime?
  school          String?
  country         String?
  lastAffiliation String?
  seasonExp       Int?
  rosterStatus    String?
  draftYear       Int?
  draftRound      Int?
  draftNumber     Int?

  gameStats       PlayerGameStat[]
  predictions     PlayerPrediction[]
  lineupSlots     LineupSlot[]
  followedByUsers UserFollowedPlayer[]

  savedComparisonSlots SavedComparisonPlayer[]
  savedLineupSlots     SavedLineupSlot[]

  // Roster lookups (team profile, game detail, suggested players) filter on it.
  @@index([teamId])
}

model Game {
  id         String   @id @default(uuid())
  nbaGameId  String   @unique
  gameDate   DateTime
  season     String
  homeTeamId String
  awayTeamId String
  homeTeam   Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam   Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore  Int?
  awayScore  Int?

  // Defaulting to REGULAR is exactly right for backfill, not just a
  // convenient fallback: every Game row that existed before this column
  // came through LeagueGameFinder with season_type_nullable="Regular
  // Season" (see apps/ingestion/games.py), so the migration needs no data
  // cleanup pass.
  seasonType SeasonType @default(REGULAR)

  // 1-4 for PLAYOFFS/FINALS games, null for REGULAR and PLAY_IN. Derived
  // from the NBA game id at ingestion time — see classify_game().
  playoffRound Int?

  playerStats      PlayerGameStat[]
  events           GameEvent[]
  ingestionBatches IngestionBatch[]
  prediction       GamePrediction?
  predictionRuns   GamePredictionRun[]
  marketOdds       GameMarketOdds?

  picks GamePick[]

  @@index([seasonType])
  // Nearly every Game read orders by gameDate (upcoming/completed lists,
  // recent results, evaluated games), and every per-player stats read orders
  // its rows by the joined game's date.
  @@index([gameDate])
  // A team's schedule and results filter on one side and order by date;
  // Postgres combines the two indexes for the OR across home and away.
  @@index([homeTeamId, gameDate])
  @@index([awayTeamId, gameDate])
}

// Raw play-by-play events — the source of truth every derived stat traces back to.
// Every row this project's own ingestion pipeline writes — the actions in
// a PlayByPlayV3 response, one row each — plus, historically, two
// PERIOD_START/PERIOD_END bookend rows per game that predate real
// play-by-play ingestion. See apps/ingestion/play_by_play.py.
model GameEvent {
  id          String   @id @default(uuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id])

  // Both together are the platform's own event schema a submitted row is
  // checked against before acceptance — see event_validation.py.
  sequence  Int // NBA's own actionNumber; strictly increasing within a game
  period    Int
  clock     String
  eventType String // NBA's actionType, e.g. "2pt", "rebound", "turnover"

  // Null for a team-level action (e.g. a team rebound) or one this
  // schema's validation didn't need to resolve — never a stand-in for "we
  // don't know", which the rejection path handles instead.
  subType String?

  playerId String?
  team     Team?   @relation(fields: [teamId], references: [id])
  teamId   String?

  // Made/missed, for shot and free-throw actions only — null otherwise,
  // not a false "not made".
  success Boolean?
  // Point value of a made shot/free throw (1, 2 or 3) — null otherwise.
  value Int?

  description String

  // Which ingestion run wrote this row — see IngestionBatch. Nullable and
  // onDelete: SetNull for the same reason User.favoriteTeamId is: cleaning
  // up an old batch record must never be able to cascade-delete real event
  // history that other rows (and every stat derived from it) still depend
  // on.
  batchId String?
  batch   IngestionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // One row per (game, NBA actionNumber) — the constraint this schema was
  // missing before real play-by-play ingestion existed. Without it, the
  // old bookend-only ON CONFLICT DO NOTHING upsert silently duplicated its
  // two dummy rows on every re-run (ids are random UUIDs, which never
  // collide) — see this migration's own comment for the cleanup that had
  // to happen alongside adding it.
  @@unique([gameId, sequence])
}

// One row per play-by-play ingestion attempt for one game — the automated
// pipeline's own "submission" a published stat traces back to, alongside
// the GameEvent rows it wrote. Append-only like GamePredictionRun: a
// re-ingested game gets a NEW batch row rather than overwriting the last
// one, so run history (including past rejections) is never lost.
//
// Deliberately scoped to this project's own automated ingestion pipeline,
// not a multi-human-submitter workflow with per-user approval — this
// project pulls from the NBA's own authoritative stats feed rather than
// accepting hand-entered boxscores from many submitters, so "the approved
// submitter" is this pipeline itself, run under one source identifier.
model IngestionBatch {
  id     String @id @default(uuid())
  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  // e.g. "nba_api:playbyplayv3" — mirrors GamePredictionRun.modelVersion:
  // a stat stays traceable to the exact source that derived it even after
  // the pipeline itself moves on to a different one.
  source String

  status         IngestionBatchStatus @default(RUNNING)
  startedAt      DateTime             @default(now())
  completedAt    DateTime?
  eventsAccepted Int                  @default(0)
  eventsRejected Int                  @default(0)

  // Reason code -> count (e.g. {"UNKNOWN_ACTION_TYPE": 2}), from
  // event_validation.py. A rejection must tell the submitter what was
  // wrong rather than fail quietly — this is that record, readable back
  // by a human or a future admin view, not queried into individually
  // (hence Json rather than a child table).
  rejectionSummary Json?

  events GameEvent[]

  @@index([gameId])
  @@index([status])
}

enum IngestionBatchStatus {
  RUNNING
  COMPLETED
  FAILED
}

// Per-game boxscore figures — derived from GameEvent rows via
// apps/ingestion/derive_player_game_stats.py, never entered by hand.
// Exceptions: minutes and plusMinus (see their own field comments below)
// stay sourced from the official boxscore/PlayerGameLogs feeds — the same
// "stored as given, not invented" precedent this model already sets for
// usage rate and the two ratings, applied here because replaying
// substitution events to recover on-court time correctly would need a
// full stateful stint simulation to reproduce a number the official feed
// already provides for free.
model PlayerGameStat {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  gameId   String
  game     Game   @relation(fields: [gameId], references: [id])

  // The team this player suited up for IN THIS GAME — not necessarily
  // Player.teamId (a player's current team), which drifts out of sync the
  // moment they're traded. apps/ingestion/games.py already knows this per
  // boxscore row (it iterates each team's own player list) but discarded
  // it before this field existed; four_factors.py used to join on
  // Player.teamId instead, which silently misattributed every traded
  // player's past games to their new team (~7.7% of rows, confirmed via a
  // one-off audit query before this field was added). Nullable because
  // older rows ingested before this field existed may not have a
  // reliable backfill source without a boxscore re-fetch.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  // Not event-derived, unlike everything else on this model — see the
  // model's own doc comment above. Kept sourced from BoxScoreTraditionalV3
  // (as it always has been): correct on-court time needs a full stateful
  // replay of every substitution event per team/period, for a number the
  // official feed already provides for free.
  minutes Int

  points              Int
  rebounds            Int
  assists             Int
  steals              Int
  blocks              Int
  turnovers           Int
  fieldGoalsMade      Int
  fieldGoalsAttempted Int
  threesMade          Int
  threesAttempted     Int
  freeThrowsMade      Int
  freeThrowsAttempted Int

  // Everything below is nullable because it only arrives from an ingestion
  // run new enough to fetch it — rows written before these columns existed
  // keep a genuine "we never recorded this", which the API and UI render as
  // "—" rather than as a zero. A zero here would be a real, and wrong,
  // measurement: 0.0 plus/minus means an even game, not a missing one.
  //
  // Offensive/defensive rebounds are derived from GameEvent rebound
  // actions (subType "offensive"/"defensive"), like the counting stats
  // above — apps/predictor/four_factors.py documents having once left
  // Oliver's offensive-rebound factor out for want of exactly this split.
  offensiveRebounds Int?
  defensiveRebounds Int?

  // Plus/minus is an observation, not a calculation — it cannot be derived
  // from any combination of the columns above, event-sourced or not. Also
  // from BoxScoreTraditionalV3, so it costs no extra API call. Same
  // not-event-derived exception as minutes above.
  plusMinus Int?

  // From BoxScoreAdvancedV3, one extra call per game. These are NBA's own
  // official figures rather than approximations: individual offensive and
  // defensive ratings need possession estimates and opponent context this
  // schema doesn't hold, so computing them here would be inventing a
  // statistic rather than deriving one. Stored as given.
  //
  // Deliberately NOT stored: true shooting %, effective FG% and
  // assist-to-turnover ratio, which this project derives at request time
  // instead (see StatsService). Those three were verified to match this
  // endpoint's values exactly, so storing them would add a second source of
  // truth for a number already computable from the boxscore.
  usagePercentage Float?
  offensiveRating Float?
  defensiveRating Float?

  @@unique([playerId, gameId])
  // The unique index above leads with playerId, so it can't serve lookups
  // from the game side: a game's boxscore, or joins filtered on Game columns
  // (seasonType, gameDate) that start from the matching games.
  @@index([gameId])
}

// Below models support the fantasy-lineup optimizer: a small Python service
// (apps/optimizer) predicts each player's next-game fantasy points and
// picks an optimal lineup under a salary cap, writing its output here.
// NestJS only ever reads these tables — nothing under /v1 writes to them.

// One row per player per optimizer run. `salary` is a synthetic DFS-style
// cost derived from the same prediction (there's no public API for real
// DraftKings/FanDuel pricing), not a real market price — see
// apps/optimizer/predict.py.
model PlayerPrediction {
  id                     String   @id @default(uuid())
  playerId               String
  player                 Player   @relation(fields: [playerId], references: [id])
  predictedFantasyPoints Float
  salary                 Int
  asOf                   DateTime @default(now())

  @@index([playerId, asOf])
}

// A single optimizer run's chosen lineup (MILP solve over the latest
// PlayerPrediction rows) — see apps/optimizer/optimize.py.
model Lineup {
  id                   String   @id @default(uuid())
  totalPredictedPoints Float
  totalSalary          Int
  budget               Int
  createdAt            DateTime @default(now())

  slots LineupSlot[]
}

model LineupSlot {
  id       String @id @default(uuid())
  lineupId String
  lineup   Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  @@unique([lineupId, playerId])
}

// A lineup a user chose to keep, snapshotted from the optimizer board —
// written by the NestJS API (POST /v1/me/lineups), unlike Lineup above
// which the Python optimizer service writes. One user can save any number
// of lineups over a season. The table itself is created by the
// home_personalization migration (the home page shipped this model first);
// the column set below must stay in sync with that migration.
model SavedLineup {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Every lineup gets a name on save — POST /v1/me/lineups rejects a missing
  // or blank one — so a shelf of saves stays tell-apart-able.
  name   String

  // Which optimizer run the save came from. Optional and currently unused:
  // this API freezes the client-sent board instead of copying the optimizer's
  // own Lineup row, but the column exists for the home-page flow that does.
  sourceLineupId String?

  // ── Totals snapshot, taken at the moment the lineup was saved ──
  // PlayerPrediction is append-and-take-latest-by-asOf: the optimizer writes
  // a fresh row per player per run and readers take the newest. Re-deriving
  // these totals on read would therefore quietly return different numbers
  // than the ones the user was looking at when they hit save — the lineup
  // would appear to change on its own. Storing them makes the saved lineup a
  // record of a decision rather than a live recomputation.
  totalPredictedPointsAtSave Float
  totalSalaryAtSave          Int
  budgetAtSave               Int

  createdAt DateTime @default(now())

  slots SavedLineupSlot[]

  @@index([userId, createdAt])
}

// One player within a saved lineup, with that player's predicted points and
// salary as they stood at save time — same reason as SavedLineup's totals.
model SavedLineupSlot {
  id            String      @id @default(uuid())
  savedLineupId String
  savedLineup   SavedLineup @relation(fields: [savedLineupId], references: [id], onDelete: Cascade)
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  predictedPointsAtSave Float
  salaryAtSave          Int

  @@unique([savedLineupId, playerId])
}

// Below model supports game-outcome prediction: a small Python service
// (apps/predictor) computes an Elo-based home win probability and a Four
// Factors-based predicted score margin for each game, writing its output
// here. NestJS only ever reads this table — nothing under /v1 writes to it.
//
// One row per Game (@@unique([gameId]), upserted on rerun) rather than
// PlayerPrediction's append-and-take-latest-by-asOf shape: nothing here
// wants "what did we predict for this game last Tuesday vs today" the way
// fantasy-point predictions do, so a single row keeps reads a direct
// `game.prediction` relation instead of a DISTINCT ON query.
//
// This table is deliberately still upsert-only — it's the fast "current
// prediction" view every existing read path (picks, leaderboard, follows,
// teams) depends on via the `game.prediction` 1:1 relation. Reproducibility
// across model changes lives in GamePredictionRun below instead of here, so
// none of those read paths had to change shape to get it.
model GamePrediction {
  id String @id @default(uuid())

  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id])

  // Elo-based win probability for the home team, in [0, 1]. See
  // apps/predictor/elo.py.
  homeWinProbability Float

  // Elo ratings each team carried into this game, before it was played —
  // kept alongside the derived probability so a caller can see why it came
  // out the way it did, not just the number itself.
  homeTeamEloPre Float
  awayTeamEloPre Float

  // Four Factors-based predicted margin, home minus away, in points. See
  // apps/predictor/four_factors.py. Null when either team has no completed
  // games yet to average Four Factors from.
  predictedMarginHome Float?

  // Which method produced predictedMarginHome: "regression" (fitted OLS)
  // or "heuristic" (fixed literature-informed weights, used when there
  // isn't enough game history to fit a regression reliably — see
  // four_factors.py's MINIMUM_GAMES_FOR_REGRESSION). Null alongside a null
  // predictedMarginHome.
  marginMethod String?

  // Which predictor model definition produced this row — see
  // GamePredictionRun.modelVersion below. Lets a caller see, without a
  // second query, whether "the current prediction" was made under today's
  // model or an older one that just hasn't been rerun yet.
  modelVersion String @default("unversioned")

  createdAt DateTime @default(now())

  @@index([gameId])
}

// Append-only prediction history: one row per (game, model version) ever
// produced by predict_games.py, upserted only within the same version and
// never overwritten across a version change. GamePrediction above always
// reflects the latest run, so once MODEL_VERSION is bumped in
// predict_games.py, every prior version's numbers stay exactly as they were
// computed — "a figure published under one definition stays reproducible
// after it changes" — queryable here instead of only living in a report PDF
// or being silently replaced in place.
model GamePredictionRun {
  id String @id @default(uuid())

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  // Identifies the exact model definition this row was computed under —
  // see predict_games.py's MODEL_VERSION docstring for the versioning
  // convention (bump the Elo or Four Factors component independently).
  modelVersion String

  homeWinProbability  Float
  homeTeamEloPre      Float
  awayTeamEloPre      Float
  predictedMarginHome Float?
  marginMethod        String?

  createdAt DateTime @default(now())

  // One row per game per version — rerunning the same version (e.g. after
  // reseeding data) refreshes its numbers rather than accumulating
  // duplicate rows for a definition that hasn't actually changed.
  @@unique([gameId, modelVersion])
  @@index([gameId])
}

// Pre-game market win-probability snapshot, fetched from The Odds API by
// apps/ingestion/fetch_market_odds.py — this project's second external API
// integration, and a demanding baseline for GamePrediction's own
// homeWinProbability: a sportsbook's line reflects real money, not just
// this project's own boxscore history, so "does the model beat the
// market" is a much stronger question than "does it beat a coin flip."
//
// Deliberately its own table rather than extra columns on GamePrediction,
// even though both describe the same game's pre-game state: they're
// written by two independent, unrelated processes (predict_games.py vs.
// fetch_market_odds.py), and an odds-API outage or exhausted free-tier
// quota must never be able to block Elo/Four Factors from writing their
// own prediction, or vice versa.
//
// The Odds API's free tier only ever returns current/upcoming lines, never
// historical closing lines (a paid-tier feature) — see
// fetch_market_odds.py's module docstring. That's why this row is only
// ever written/refreshed while the game is still upcoming: once it's been
// played, re-fetching "today's odds" for it isn't possible at all, so the
// script stops touching it, preserving whichever pre-tip-off snapshot was
// last taken rather than nothing (or something dishonestly reconstructed).
model GameMarketOdds {
  id     String @id @default(uuid())
  gameId String @unique
  game   Game   @relation(fields: [gameId], references: [id])

  // De-vigged (bookmaker-overround-removed) home win probability, averaged
  // across every US bookmaker's moneyline the API returned for this game —
  // see fetch_market_odds.py's remove_vig for the formula and why a book's
  // own quoted price alone overstates both teams' true win probability.
  homeWinProbability Float

  // How many bookmakers homeWinProbability is averaged over — surfaced
  // alongside the number so a caller can judge how stable it is rather
  // than treating it as if it came from one canonical source.
  bookmakerCount Int

  // Which provider this came from, so a second odds source could be added
  // later without a schema change or ambiguity about which row is which.
  source String @default("the-odds-api")

  // When this snapshot was actually fetched — distinct from any Prisma
  // bookkeeping timestamp, since re-running the ingestion script while a
  // game is still upcoming updates this row's numbers in place (a fresher
  // pre-tip-off line), and callers care when the line itself was taken,
  // not when the database row happened to last be touched.
  fetchedAt DateTime

  @@index([gameId])
}

// ─────────────────────────────────────────────────────────────────────────
// Personalization models. Everything below records a CHOICE THE USER MADE —
// which players they follow, which games they called, which comparisons and
// lineups they saved. No NBA data is ingested, derived or duplicated here
// beyond the deliberate at-the-time snapshots documented on GamePick and
// SavedLineup; the pipeline's own tables (Team/Player/Game/PlayerGameStat/
// GamePrediction/PlayerPrediction/Lineup) stay read-only exactly as before.
//
// Every relation uses onDelete: Cascade, toward Player/Team/Game as well as
// User. Prisma's default (Restrict) would mean a single followed player is
// enough to make a re-ingestion that deletes and rewrites roster rows fail
// outright — a user's bookmark must never be able to block the data pipeline.
// ─────────────────────────────────────────────────────────────────────────

// Whether the user's call turned out right, once the game has a final score.
enum PickOutcome {
  CORRECT
  MISSED
}

// The user calling a COMPLETED game whose score they have not been shown:
// "I think this team won". Only a game that already has a final score and a
// stored prediction can be called, and it is graded immediately — see
// PicksService.createPick and ChallengeService.findNextUncalledGame.
//
// This scores recall and judgement against past games, not forecasts of
// future ones. The same table becomes forward picks unchanged the day
// ingestion starts writing unplayed Game rows.
model GamePick {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  // Which side the user took. A plain String rather than a relation to Team:
  // it is always one of the game's own homeTeamId/awayTeamId, validated at
  // write time, and a second Team relation here would add a foreign key that
  // buys nothing the game's own two team relations don't already give.
  pickedTeamId String

  // Right or wrong, filled in from the game's final score.
  outcome PickOutcome

  // ── Model snapshot, taken at the moment the pick was made ──
  // These duplicate GamePrediction's columns on purpose. GamePrediction is
  // `gameId @unique` and is UPSERTED by apps/predictor/predict_games.py, so
  // the row is overwritten in place on every run: the numbers the model was
  // showing when the user made this call are destroyed the next time the
  // predictor runs. Copying them here is the only way the question "what did
  // the model say when I called it, and did I disagree?" stays answerable —
  // reading GamePrediction later answers a different question (what the model
  // says NOW), silently and with no way to tell the difference.
  modelHomeWinProbabilityAtPick Float
  modelPredictedMarginAtPick    Float?
  homeTeamEloAtPick             Float
  awayTeamEloAtPick             Float

  createdAt DateTime @default(now())

  // One call per game per person — a pick is a commitment, not a running
  // opinion, so a second call on the same game is REJECTED with a 409 rather
  // than replacing the first. There is no update path; see
  // translatePickWriteError in picks.service.ts, which turns the P2002 this
  // constraint raises into that 409.
  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

// A named set of players the user lined up side by side, so the same
// comparison can be reopened later without rebuilding it.
model SavedComparison {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  players SavedComparisonPlayer[]

  @@index([userId, createdAt])
}

// One player within a saved comparison. `position` is the left-to-right
// ordering the user arranged them in, not a basketball position — the
// player's basketball position lives on Player.position.
model SavedComparisonPlayer {
  id                String          @id @default(uuid())
  savedComparisonId String
  savedComparison   SavedComparison @relation(fields: [savedComparisonId], references: [id], onDelete: Cascade)
  playerId          String
  player            Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  position          Int

  @@unique([savedComparisonId, playerId])
}
