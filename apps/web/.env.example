# Web app environment variables. Copy to .env for local overrides, or set as
# build-time environment variables for production builds.
#
# Leave this unset. Both dev (Vite's proxy, see vite.config.ts) and
# production (Cloudflare Pages Functions, see functions/api/[[path]].ts and
# functions/auth/[[path]].ts) route /api and /auth same-origin to the NestJS
# API, so the browser never needs to know its address -- see
# docs/decisions/ADR-003-hosting-topology.md for why that matters for auth.
# Only set this to call a specific backend directly, bypassing the proxy.
VITE_API_BASE_URL=
