# Web app environment variables. Copy to .env for local overrides, or set as
# build-time environment variables for production builds.
#
# The production origin of the NestJS API. In dev this is unset, so the Vite
# dev proxy (/api -> http://localhost:4000) is used and the BetterAuth client
# defaults to http://localhost:4000. In production (Azure Static Web Apps) set
# this to the API's public origin, e.g. https://api.example.com — the SPA then
# calls it directly, cross-origin, with CORS + Secure/SameSite=None cookies.
VITE_API_BASE_URL=
